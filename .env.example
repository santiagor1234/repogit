# Copiar a .env y completar para activar IA real en las demos (opcional, todas funcionan sin esto)
# Gemini es gratis (aistudio.google.com/apikey) y tiene prioridad si está configurada.
GEMINI_API_KEY=
# Alternativa de pago, se usa solo si no hay GEMINI_API_KEY
OPENAI_API_KEY=

# Para automations/telegram-bot (ver su README.md: token gratis vía @BotFather)
TELEGRAM_BOT_TOKEN=
BUSINESS_NAME=Mi Negocio
BUSINESS_ADDRESS="Cra 15 #93-47, Bogotá"
BUSINESS_PHONE=+57 300 000 0000
# URL de la web de reservas (booking_url) — el default ya apunta a la página publicada
BOOKING_URL=
# URL pública de automations/booking-api ya desplegada (ej. Render) — sin esto, la web
# de reservas queda en "vista previa" y no guarda citas de verdad
BOOKING_API_URL=
