# Copiar a .env y completar para activar IA real en las demos (opcional, todas funcionan sin esto)
# Gemini es gratis (aistudio.google.com/apikey) y tiene prioridad si está configurada.
GEMINI_API_KEY=
# Alternativa de pago, se usa solo si no hay GEMINI_API_KEY
OPENAI_API_KEY=

# Para automations/telegram-bot (ver su README.md: token gratis vía @BotFather)
TELEGRAM_BOT_TOKEN=
BUSINESS_NAME=Mi Negocio
